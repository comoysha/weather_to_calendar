<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.xiayue.weather-to-calendar</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>export TZ=Asia/Shanghai; cd /Users/xiayue/raycast_script/weather_to_calendar &amp;&amp; /Users/xiayue/raycast_script/weather_to_calendar/weather_to_calendar.sh -s $(date +%H:00) -e $(date +%H:00)</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/xiayue/raycast_script/weather_to_calendar</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key>
    <string>Asia/Shanghai</string>
  </dict>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>6</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>12</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>20</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/xiayue/raycast_script/weather_to_calendar/logs/weather_to_calendar.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/xiayue/raycast_script/weather_to_calendar/logs/weather_to_calendar.stderr.log</string>

  <key>RunAtLoad</key>
  <false/>

  <key>KeepAlive</key>
  <false/>
</dict>
</plist>
